[Unit]
Description=Fenced VaultContext demo reset

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/etc/vaultcontext-demo/reset.env
ExecStart=/usr/bin/python3 /opt/vaultcontext-demo/deploy/demo/reset.py --config /etc/vaultcontext-demo/reset.json
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
