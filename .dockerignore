# Deny everything, then allow only what the Dockerfile copies. .envrc, .env*, pb_data/, .git/,
# tests/, skills/, and any new file stay out of the build context unless they are listed here.
*
!POCKETCONTEXT_VERSION
!pocketcontext.json
!pb_migrations/*.js
!pb_hooks/*.js
!pb_public/index.html
!pb_public/styles.css
!pb_public/app.js
!pb_public/analytics-frame.html
!pb_public/analytics-frame.js
!pb_public/og-card.png
!docker/entrypoint.py
!docker/litestream.yml

# Demo client assets and verification dependency are deliberately packaged.
!pb_hooks/vendor/*.js
!pb_hooks/vendor/tweetnacl-LICENSE
!pb_hooks/vendor/README.txt
!pb_hooks/vendor/provenance.json
!pb_public/demo/**
!deploy/demo/retention.py
!deploy/demo/contact_replica.py
!deploy/demo/contact-litestream.yml

# Rebuild approved public downloads; never import generated local binaries.
pb_public/demo/downloads/
!pyproject.toml
!src/vaultcontext_client/*.py
!src/vaultcontext_client/schema.json
!skills/vaultcontext/SKILL.md
!skills/vaultcontext/references/schema.md
!skills/vaultcontext/references/workflows.md
!scripts/build-demo-downloads.py
